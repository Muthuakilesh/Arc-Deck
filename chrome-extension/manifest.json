{
  "manifest_version": 3,
  "name": "ArcDeck YouTube Bridge",
  "version": "1.0.0",
  "description": "Shows and controls the active YouTube tab from ArcDeck.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ArcDeck YouTube Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["media-session.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
